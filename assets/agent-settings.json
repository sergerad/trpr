{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["{{RUN_DIR}}"],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git filter-branch:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue create:*)",
      "Bash(gh repo:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(gh gist:*)"
    ]
  }
}
